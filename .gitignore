# Course material — large and copyrighted. Lives in Google Drive, never in git.
*.pdf
*.ppt
*.pptx
*.doc
*.docx
*.xls
*.xlsx
*.zip

# Exception: assignment briefs are small, ours to keep, and useful in-repo —
# track PDFs that live directly in an assignment folder (e.g. ass-1/, Assignment/).
!2026-2027-Sem1/*/[Aa]ss*/*.pdf

# Textbooks kept locally for reference — never committed
_library/
!_library/README.md

# Data & models
*.csv
*.parquet
*.db
*.sqlite
*.bin
*.safetensors
*.gguf
*.ckpt
data/

# Model directories may contain lightweight config/tokenizer metadata worth tracking;
# large weights remain excluded by the binary extension rules above.

# Exception: 521 ass-1's dataset is small, downloaded/generated by the notebook
# itself (not raw copyrighted course material), and useful in-repo so the team
# doesn't each have to re-download it — track it like the assignment-PDF exception above.
!2026-2027-Sem1/AIMLCZG521-ConversationalAI/ass-1/data/
!2026-2027-Sem1/AIMLCZG521-ConversationalAI/ass-1/data/**

# Exception: 521 ass-1's report and all working files are the group's own work
# (generated from the notebook's executed results), not raw copyrighted course material
# — track them in the assignment folder.
!2026-2027-Sem1/AIMLCZG521-ConversationalAI/ass-1/*.docx
!2026-2027-Sem1/AIMLCZG521-ConversationalAI/ass-1/*.ipynb



# Secrets
.env
.env.*
*.key
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Transcripts — raw source, not knowledge base. Read them to build/update the note,
# fold the important content (instructor quotes, emphasis, off-slide clarifications)
# into the session note, then don't commit. The note is the record, not the transcript.
# Transcripts are raw source: read them, fold them into the note, discard.
# The .gitkeep exception is load-bearing — the directory's CONTENTS are ignored,
# so without it the folder wouldn't exist on a fresh clone and there'd be nowhere
# obvious to drop a transcript. This is the only .gitkeep in the repo that has a
# job; git tracks files, not folders, so every other directory appears by itself
# the moment it holds something real.
2026-2027-Sem1/*/source/transcripts/*
!2026-2027-Sem1/*/source/transcripts/.gitkeep

# Tool dependencies — reinstall with `cd tools && npm install`
tools/node_modules/
tools/package-lock.json
